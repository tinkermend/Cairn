# 复制为 deploy/.env 后再 up。
# 凭据与远端 shsnc-ah3 对齐（见 docs/deploy/2026-09-10-shsnc-ah3-infra.md），不要把填好的 .env 入库。

CAIRN_DB_USER=cairn
CAIRN_DB_PASSWORD=

# API 若在反代后，按可信跳数填写；0 表示不信任 X-Forwarded-For。
CAIRN_TRUST_PROXY_HOPS=0
CAIRN_DB_NAME=cairn
CAIRN_DB_PORT=5432

CAIRN_S3_ACCESS_KEY=
CAIRN_S3_SECRET_KEY=
CAIRN_S3_REGION=us-east-1
CAIRN_S3_BUCKET=cairn-evidence
# 与远端 RustFS 宿主端口对齐，只把 IP 换成 127.0.0.1。
CAIRN_S3_API_PORT=9021
CAIRN_S3_CONSOLE_PORT=9022

# 本编排是 PostgreSQL，CAIRN_CHANGE_HINT=auto 即 LISTEN/NOTIFY，不必配 Redis。
# MySQL / SQLite 要实时观察时再设 CAIRN_REDIS_URL。

# 受管浏览器内部通道。非 development 必须覆盖内部密钥；跨主机必须 https。
CAIRN_INTERNAL_AUTH_SECRET=
CAIRN_WORKER_ENDPOINTS=local-worker=http://127.0.0.1:8091
CAIRN_WORKER_INTERNAL_HOST=127.0.0.1
CAIRN_WORKER_INTERNAL_PORT=8091
