{
  "name": "@cairn/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "browser:install": "playwright install chromium",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node -c blue,green \"tsc -w --preserveWatchOutput -p tsconfig.build.json\" \"node --watch --watch-preserve-output dist/main.js\"",
    "register-ai-secret": "node dist/bin/register-browser-ai-secret.js"
  },
  "dependencies": {
    "@cairn/db": "workspace:*",
    "@cairn/secret": "workspace:*",
    "@cairn/shared": "workspace:*",
    "@cairn/storage": "workspace:*",
    "@midscene/core": "1.12.6",
    "@midscene/shared": "1.12.6",
    "@midscene/web": "1.12.6",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "playwright": "1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^25.9.5",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  }
}
