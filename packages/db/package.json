{
  "name": "@cairn/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/test-entry.d.ts",
      "default": "./dist/test-entry.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:compatibility": "CAIRN_DB_CONTRACT_DRIVERS=postgres,mysql vitest run",
    "test:rf06": "CAIRN_RF06_FULL=1 vitest run src/__tests__/run-lease-fencing.test.ts",
    "migrate": "node dist/bin/migrate-cli.js",
    "dev": "tsc -w --preserveWatchOutput -p tsconfig.build.json"
  },
  "dependencies": {
    "@cairn/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
