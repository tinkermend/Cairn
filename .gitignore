# ── 依赖与包管理 ───────────────────────────────
# 注意：不加前导 /，否则匹配不到 packages/*/node_modules
node_modules/
.pnpm-store/

# ── 构建产物 ──────────────────────────────────
dist/
build/
out/
*.tsbuildinfo
.turbo/
.vite/

# ── 测试与覆盖率 ───────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ── 浏览器运行时产物 ────────────────────────────
# Midscene 默认把报告与截图写在这里。架构文档铁律：
# 证据一律进 S3，绝不落本地磁盘 —— 更不能进 git
midscene_run/
# 受管 Chrome profile 目录含 cookie 与登录态，等同凭据
.browser-profiles/
chrome-profiles/
*.har

# ── 内部文档，另行传递 ─────────────────────────
docs/arch/
docs/deploy/

# 指令草稿，可能含凭据
.prompt
*.prompt

# ── 环境与密钥 ────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.keys/

# ── 本地服务数据卷（docker/podman compose）──────
.data/
pgdata/
minio-data/

# ── 日志与临时文件 ──────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.artifacts/
tmp/

# ── 编辑器与操作系统 ────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Claude Code ──────────────────────────────
# 开发工具与本机配置，不进产品仓库
.claude/
