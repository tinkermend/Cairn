{
  "name": "识途协同录制",
  "description": "录制浏览器操作并上传识途场景草稿",
  "version": "1.12.6",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "debugger",
    "scripting",
    "storage",
    "alarms"
  ],
  "incognito": "split",
  "background": {
    "service_worker": "./scripts/worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_icon": "icon128.png",
    "default_title": "识途协同录制"
  },
  "side_panel": {
    "default_path": "./index.html"
  },
  "icons": {
    "128": "icon128.png"
  }
}
