{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@cairn/web",
    "dev:api": "turbo run dev --filter=@cairn/api",
    "dev:worker": "turbo run dev --filter=@cairn/worker",
    "dev:backend": "turbo run dev --filter=@cairn/api --filter=@cairn/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "pnpm check && turbo run test",
    "test:unit": "pnpm check && turbo run test --filter=@cairn/shared --filter=@cairn/authoring --filter=@cairn/map --filter=@cairn/secret --filter=@cairn/storage",
    "test:db": "pnpm check && turbo run test --filter=@cairn/db",
    "test:db:compatibility": "pnpm check && pnpm --filter @cairn/db test:compatibility",
    "test:api": "pnpm check && turbo run test --filter=@cairn/api",
    "test:worker": "pnpm check && turbo run test --filter=@cairn/worker",
    "test:omf-e2e": "pnpm --filter @cairn/api exec vitest run --config vitest.omf-e2e.config.mts",
    "test:rf06": "pnpm --filter @cairn/db test:rf06",
    "typecheck": "turbo run typecheck",
    "check": "node tools/check-deps.mjs && pnpm check:migrations && node tools/check-invariants.mjs",
    "check:invariants": "node tools/check-invariants.mjs",
    "check:migrations": "node tools/check-migrations.mjs && node --test tools/lib/migrations.test.mjs",
    "check:deps": "node tools/check-deps.mjs",
    "check:design": "node docs/design/front/check.mjs",
    "env:use": "node tools/use-env.mjs",
    "env:status": "node tools/use-env.mjs status",
    "infra:up": "podman compose -f deploy/compose.yml up -d",
    "infra:down": "podman compose -f deploy/compose.yml down",
    "infra:status": "podman compose -f deploy/compose.yml ps",
    "infra:logs": "podman compose -f deploy/compose.yml logs -f --tail=80",
    "db:migrate": "pnpm --filter @cairn/db migrate",
    "db:new-migration": "node tools/allocate-migration.mjs",
    "secret:register-browser-ai": "pnpm --filter @cairn/worker register-ai-secret",
    "start": "./scripts/stack.sh start",
    "stop": "./scripts/stack.sh stop",
    "restart": "./scripts/stack.sh restart",
    "status": "./scripts/stack.sh status",
    "clean": "./scripts/stack.sh clean",
    "ports:clean": "./scripts/stack.sh clean",
    "logs": "./scripts/stack.sh logs",
    "test:sessions:e2e": "pnpm --filter @cairn/api... --filter @cairn/worker... build && node tests/session-management-e2e/run.mjs",
    "test:sessions:adversarial": "pnpm --filter @cairn/api... --filter @cairn/worker... build && node tests/session-management-e2e/adversarial.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "turbo": "^2.10.13"
  }
}
