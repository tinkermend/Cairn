{
  "name": "cairn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check:migrations": "node tools/check-migrations.mjs",
    "db:migrate": "pnpm --filter @cairn/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
