# ══════════════════════════════════════════════════════════════
# 平台自有配置（一律 CAIRN_ 前缀）
#
# 连接画像：本机与远程开发机的差异只应写在 .env.local / .env.remote。
# 进程永远只读仓库根的 .env（由 pnpm env:use 指到当前画像）。
#   pnpm env:use local    # 本机 PostgreSQL + 本地对象存储
#   pnpm env:use remote   # 远程库 + 远程对象存储
#   pnpm env:status
# ══════════════════════════════════════════════════════════════

# ── 启动必校验：进程会在 listen / 领任务之前拒绝非法取值 ──
# 留空等于未设置，会回落到 schema 默认值。

# 数据库：postgres（默认）| mysql | sqlite。API、Worker 与迁移必须使用同一配置。
# SQLite 仅支持本机文件；选择 sqlite 时无需 host/user/password。
CAIRN_DB_DRIVER=postgres
CAIRN_DB_FILE=.data/cairn.sqlite
# MySQL 8.4 的默认端口为 3306，以下是 PostgreSQL 的示例。
CAIRN_DB_HOST=
CAIRN_DB_PORT=5432
CAIRN_DB_NAME=cairn
CAIRN_DB_USER=
CAIRN_DB_PASSWORD=
CAIRN_DB_SCHEMA=cairn

# 运行观察变化提示。auto：PostgreSQL 用 LISTEN/NOTIFY；MySQL / SQLite 仅在配置了 Redis 时用 Pub/Sub。
# Redis 只做提示扇出，不是队列、锁或运行状态事实源。未配置时 SSE 仍可补读，ready.realtime=false。
CAIRN_CHANGE_HINT=auto
# CAIRN_REDIS_URL=redis://127.0.0.1:6379
# CAIRN_CHANGE_HINT_NAMESPACE=
# CAIRN_RUN_EVENT_RETAIN_DAYS=7

# 运行环境与日志
# CAIRN_ENV 只表达「环境相关的强度差异」，不承担业务分支；工具链仍看 NODE_ENV。
# 非 development 时，下面的 JWT 密钥与管理员口令必须覆盖，否则进程拒绝启动。
CAIRN_ENV=development
CAIRN_LOG_LEVEL=info

# 控制面（api）
CAIRN_API_PORT=3030
# 逗号分隔的 origin 白名单。每项必须带 scheme（浏览器发出的 Origin 永远带），
# 至少一项；拆不出合法 origin 时进程拒绝启动。
CAIRN_CORS_ORIGINS=http://localhost:5173
# 信任的反向代理跳数。0 只用套接字对端，忽略 X-Forwarded-For。
CAIRN_TRUST_PROXY_HOPS=0
CAIRN_JWT_SECRET=dev-only-change-me-jwt-secret   # CAIRN_ENV 非 development 时必须覆盖
CAIRN_JWT_EXPIRES_IN=12h
CAIRN_BOOTSTRAP_ADMIN_EMAIL=admin                # 登录账号，不是邮箱
CAIRN_BOOTSTRAP_ADMIN_PASSWORD=cairn-admin       # CAIRN_ENV 非 development 时必须覆盖
CAIRN_BOOTSTRAP_ADMIN_NAME=Administrator
# 本地 SecretProvider 的 AES-256-GCM 主密钥：base64 编码的恰好 32 字节。
# 开发默认值解码为 ASCII「cairn-dev-only-credential-key-01」。
# api（写入凭据）与 worker（自动登录解密）共用；非 development 必须覆盖。
CAIRN_CREDENTIAL_KEY=Y2Fpcm4tZGV2LW9ubHktY3JlZGVudGlhbC1rZXktMDE=
# 开发默认内部 HMAC，解码为 ASCII「cairn-dev-only-internal-auth-k01」。
# API 与 Worker 共用；非 development 必须覆盖。
CAIRN_INTERNAL_AUTH_SECRET=Y2Fpcm4tZGV2LW9ubHktaW50ZXJuYWwtYXV0aC1rMDE=
# API 转发受管浏览器时使用。workerId=baseUrl，逗号分隔；http 仅 loopback。
# distributed 模式未配置时为空映射，不注入本机默认值。
CAIRN_WORKER_ENDPOINTS=local-worker=http://127.0.0.1:8091
# local：同机网络命名空间；distributed：必须显式非 loopback HTTPS 广告 URL。
CAIRN_WORKER_NETWORK_MODE=local
# 显式广告入口。未设置时库内 internal_base_url 为 null，不从监听地址拼接。
CAIRN_WORKER_ADVERTISE_URL=
# Worker 内部 HTTP。只允许 loopback；0 仅用于 local 测试且不得同时配广告 URL。
CAIRN_WORKER_INTERNAL_HOST=127.0.0.1
CAIRN_WORKER_INTERNAL_PORT=8091

# 执行面（worker）
# 正式部署每实例必须唯一；同 ID 双开且心跳仍新鲜时启动失败。本地空值回落到 local-worker。
CAIRN_WORKER_ID=
CAIRN_WORKER_CAPACITY=1
# Worker 心跳与 RunLease 续租共用这一个定时器。
CAIRN_WORKER_HEARTBEAT_MS=5000
# 须 ≥ 3 × HEARTBEAT 秒；LOST_AFTER 必须严格大于 TTL。
CAIRN_RUN_LEASE_TTL_SECONDS=30
CAIRN_WORKER_LOST_AFTER_SECONDS=45
CAIRN_RUN_MAX_RECOVERIES=3
# 对象存储。开发默认 local，目录相对仓根解析。非 development 的 local 必须是绝对路径。
CAIRN_OBJECT_STORE=local
CAIRN_OBJECT_STORE_DIR=.data/object-store
CAIRN_OBJECT_MAX_BYTES=33554432
CAIRN_OBJECT_RETAIN_DAYS=30
CAIRN_OBJECT_PENDING_TTL_SECONDS=3600
CAIRN_OBJECT_CLEANUP_INTERVAL_MS=60000
# Trace 单独上限。超限不截断，记 trace_too_large。
CAIRN_TRACE_MAX_BYTES=134217728
# 编码后录像上限。触顶截断并保留可播前缀。
CAIRN_VIDEO_MAX_BYTES=134217728
CAIRN_EVIDENCE_UPLOAD_MAX_ATTEMPTS=3
# 仅 CAIRN_OBJECT_STORE=s3 时必填。开发不要求 MinIO。
CAIRN_S3_ENDPOINT=
CAIRN_S3_REGION=us-east-1
CAIRN_S3_BUCKET=cairn-evidence
CAIRN_S3_ACCESS_KEY=
CAIRN_S3_SECRET_KEY=
CAIRN_S3_FORCE_PATH_STYLE=true

# 浏览器会话与租约（worker）。惰性启动：首个需要会话的 Run 才 launch。
# LEASE_TTL 须 ≥ 3 × HEARTBEAT（秒）。非 development 时 PROFILE_DIR 必须是绝对路径。
# IDLE / MAX / AUTH_WAIT 已迁入控制台「治理 → 平台配置」会话组；新 Run 冻结快照。
# 这三项 env 不再是运行中的业务配置源，初始化也不会把未被消费的旧值自动激活。
# 租约 TTL、心跳、扫描节奏仍是基础设施，不进平台会话组。
CAIRN_BROWSER_HEADLESS=true
CAIRN_BROWSER_PROFILE_DIR=.data/browser-profiles
CAIRN_BROWSER_MAX_SESSIONS=2
CAIRN_BROWSER_EXECUTABLE_PATH=
CAIRN_SESSION_IDLE_TTL_SECONDS=600
CAIRN_SESSION_MAX_LIFETIME_SECONDS=14400
CAIRN_SESSION_LEASE_TTL_SECONDS=30
CAIRN_SESSION_HEARTBEAT_MS=5000
CAIRN_SESSION_REAPER_INTERVAL_MS=15000
CAIRN_SESSION_AUTH_WAIT_SECONDS=300

# 前端开发代理目标（只被 vite.config.ts 读取，不进平台 env schema）
CAIRN_API_ORIGIN=http://127.0.0.1:3030
# 可选。配置后控制台会向该扩展 ID 发送录制握手；未配置或发送失败仍可点工具栏领取同一绑定。
# VITE_CAIRN_EXTENSION_ID=

# ── 浏览器仿真 AI（仅首次导入；之后以控制台「治理 → 平台配置」为准）──
# API 第一次读取平台配置时，若库中还没有配置行，才会把当时完整且已消费的 AI 项导入。
# 重启不会重新导入覆盖。迁入后这些变量不再是运行中的业务配置源。
# hangWait 仍是高级运行配置，继续由进程读取并冻结进 Run。
# 方案：docs/spec/2026-09-13-platform-configuration-center-assessment.md
# 首次导入用的总开关。正式启停请改控制台平台配置。
CAIRN_BROWSER_AI_ENABLED=false
# 仅在首次导入且配置完整时写入数据库。之后改控制台，不要指望改 env 立刻生效。
CAIRN_BROWSER_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CAIRN_BROWSER_AI_MODEL=doubao-seed-2-1-turbo-260628
# Midscene 1.12.6 的模型族枚举：doubao-seed / doubao-vision / qwen3-vl / qwen2.5-vl / gemini / glm-v 等。
# 浏览器仿真需要能做 UI 元素定位的多模态模型；纯文本模型（含 deepseek）不适用于本条路由。
CAIRN_BROWSER_AI_MODEL_FAMILY=doubao-seed
# 开发期可直填，首次导入时会转成 Secret 引用。非 development 禁止直填明文。
CAIRN_BROWSER_AI_API_KEY=
CAIRN_BROWSER_AI_API_KEY_SECRET_ID=
# 下列三项仅在首次导入时使用；之后改控制台平台配置。
CAIRN_BROWSER_AI_REQUEST_TIMEOUT_MS=15000
CAIRN_BROWSER_AI_STEP_MAX_CALLS=20
CAIRN_BROWSER_AI_MAX_OUTPUT_TOKENS=2048
# 超时 / 取消后等待底层调用落定的窗口；未落定则关闭 Session。此项仍留 env 并冻结进 Run。
CAIRN_BROWSER_AI_HANG_WAIT_MS=5000

# ── 平台通用 AI 配置规划（未实现；以下仅说明，尚无可填写的正式变量）──
# OpenAI 兼容模型访问（计划接入 DeepSeek / 千问），独立配置，不读取 Midscene 配置，也不回退到它。
# 正式变量随读取方、Schema 校验及模型调用一起加入；具体平台 AI 功能待定。
# 详见 docs/spec/2026-09-13-ai-model-configuration-boundaries.md

# ── 探针与其他预留项（未纳入正式启动校验）──
CAIRN_SCRIPT_ROOT=./automation/scripts
# S06 在线探针。适配层读入后经 modelConfig 显式传入，禁止回落进程 MIDSCENE_*。
CAIRN_S06_ONLINE=
CAIRN_S06_MODEL_NAME=
CAIRN_S06_MODEL_FAMILY=
CAIRN_S06_MODEL_API_KEY=
CAIRN_S06_MODEL_BASE_URL=

# ── 第三方依赖自带变量（保持原名，勿加前缀，不进平台 schema）──
DATABASE_URL=
