# ══════════════════════════════════════════════════════════════
# 平台自有配置（一律 CAIRN_ 前缀）
#
# 连接画像：本机与远程开发机的差异只应写在 .env.local / .env.remote。
# 进程永远只读仓库根的 .env（由 pnpm env:use 指到当前画像）。
#   pnpm env:use local    # 本机 PostgreSQL + 本地对象存储
#   pnpm env:use remote   # 远程库 + 远程对象存储
#   pnpm env:status
#
# 架构分层约定：
# 1. 部署与进程环境配置：保留在 .env（不配就无法连库、监听、鉴权或启动）。
# 2. 平台业务默认策略：统一由 Web 控制台「治理 → 平台配置」管理并持久化到库中，
#    新 Run 启动时冻结为快照，修改 .env 不再生效。
# ══════════════════════════════════════════════════════════════

# ── 启动必校验：进程会在 listen / 领任务之前拒绝非法取值 ──
# 留空等于未设置，会回落到 schema 默认值。



# ══════════════════════════════════════════════════════════════
# 2. 数据库基础设施 (Database - API / Worker / 迁移共用)
# ══════════════════════════════════════════════════════════════
# 数据库驱动：postgres（默认）| mysql | sqlite。API、Worker 与迁移必须使用同一配置。
CAIRN_DB_DRIVER=postgres
# SQLite 仅在历史或特殊单机测试时使用。选择 sqlite 时需取消下行注释，无需配置 host/user/password：
# CAIRN_DB_FILE=.data/cairn.sqlite
# MySQL 8.4 的默认端口为 3306，以下是 PostgreSQL 的示例。
CAIRN_DB_HOST=
CAIRN_DB_PORT=5432
CAIRN_DB_NAME=cairn
CAIRN_DB_USER=
CAIRN_DB_PASSWORD=
# 仅 PostgreSQL 生效（默认 cairn）；MySQL 模式下 Database 即 Schema，无需配置此项：
CAIRN_DB_SCHEMA=cairn

# ══════════════════════════════════════════════════════════════
# 3. 平台根密钥与内部安全 (Platform Secrets & Auth)
# ══════════════════════════════════════════════════════════════
# 下面三把密钥一律必填、没有默认值，每套部署各自生成一次。
# 本文件不带可用值：照抄过去进程会以「变量名: 原因」逐行拒绝启动，而不是
# 悄悄用一把仓库里人人可见的密钥跑下去。
#
#   CAIRN_JWT_SECRET=$(openssl rand -base64 48 | tr -d '\n')
#   CAIRN_CREDENTIAL_KEY=$(openssl rand -base64 32)
#   CAIRN_INTERNAL_AUTH_SECRET=$(openssl rand -base64 32)

# Web 控制台 JWT 登录鉴权签名密钥，至少 16 字符。
CAIRN_JWT_SECRET=
CAIRN_JWT_EXPIRES_IN=12h

# 本地 SecretProvider 的 AES-256-GCM 主密钥：base64 编码的恰好 32 字节。
# API（写入凭据）与 Worker（自动登录解密）必须配同一把，否则 Worker 解不开密文。
CAIRN_CREDENTIAL_KEY=

# API 与 Worker 节点间通信内部 HMAC 鉴权密钥：base64 编码的恰好 32 字节，两端共用。
CAIRN_INTERNAL_AUTH_SECRET=

# 初始管理员账号密码已内置于种子数据（账号: admin，默认密码: cairn-admin），
# 首次登录后请在 Web 控制台及时修改密码。

# ══════════════════════════════════════════════════════════════
# 4. 公共对象存储设施 (Object Store - API / Worker 共用)
# ══════════════════════════════════════════════════════════════
# 对象存储驱动：s3（推荐，生产/联调共用桶）| local（单机文件系统备用）
CAIRN_OBJECT_STORE=s3
# 本地目录仅在 CAIRN_OBJECT_STORE=local 时生效（默认 .data/object-store，非 development 必须为绝对路径）：
# CAIRN_OBJECT_STORE_DIR=.data/object-store
# 支持人类可读格式（如 32MB, 128M, 1GB）或纯数字字节：
CAIRN_OBJECT_MAX_BYTES=32MB
# 存储桶孤儿/底层对象兜底清理周期（截图、录像、Trace 等业务证据生命周期以控制台「平台配置」为准）
CAIRN_OBJECT_RETAIN_DAYS=30
CAIRN_OBJECT_PENDING_TTL_SECONDS=3600
CAIRN_OBJECT_CLEANUP_INTERVAL_MS=60000
# Trace 单独上限。超限不截断，记 trace_too_large。
CAIRN_TRACE_MAX_BYTES=128MB
# 编码后录像上限。触顶截断并保留可播前缀。
CAIRN_VIDEO_MAX_BYTES=128MB
CAIRN_EVIDENCE_UPLOAD_MAX_ATTEMPTS=3

# ── S3 / MinIO 驱动连接（CAIRN_OBJECT_STORE=s3 时生效）──
CAIRN_S3_ENDPOINT=
CAIRN_S3_REGION=us-east-1
CAIRN_S3_BUCKET=cairn-evidence
CAIRN_S3_ACCESS_KEY=
CAIRN_S3_SECRET_KEY=
CAIRN_S3_FORCE_PATH_STYLE=true

# ══════════════════════════════════════════════════════════════
# 5. 实时变化提示与遥测总线 (Observe, Event Bus & Telemetry)
# ══════════════════════════════════════════════════════════════
# 运行观察变化提示。auto：PostgreSQL 用 LISTEN/NOTIFY；MySQL / SQLite 仅在配置了 Redis 时用 Pub/Sub。
# Redis 只做提示扇出，不是队列、锁或运行状态事实源。未配置时 SSE 仍可补读，ready.realtime=false。
CAIRN_CHANGE_HINT=auto
# CAIRN_REDIS_URL=redis://127.0.0.1:6379
# CAIRN_CHANGE_HINT_NAMESPACE=
# CAIRN_RUN_EVENT_RETAIN_DAYS=7
# 运行监控 SSE 默认 5 秒一拍，下限由服务端强制，客户端不得压得更低。
# CAIRN_MONITOR_SSE_INTERVAL_MS=5000
# CAIRN_MONITOR_SSE_MIN_INTERVAL_MS=5000
# 监控 overview 单实例短缓存，须 ≤ CAIRN_MONITOR_SSE_MIN_INTERVAL_MS。
# CAIRN_MONITOR_OVERVIEW_CACHE_MS=3000
# L4 采样与对象存储探测（api / worker 共用默认）。
# CAIRN_MONITOR_SAMPLE_INTERVAL_MS=60000
# CAIRN_MONITOR_SAMPLE_RETENTION_DAYS=30
# CAIRN_MONITOR_DISK_SAMPLE_MS=60000
# CAIRN_MONITOR_OBJECT_STORE_PROBE_MS=60000
# CAIRN_MONITOR_PURGE_INTERVAL_MS=600000

# ══════════════════════════════════════════════════════════════
# 6. 控制面（API 进程专属）
# ══════════════════════════════════════════════════════════════
CAIRN_API_PORT=3030
# 逗号分隔的 origin 白名单。每项必须带 scheme（浏览器发出的 Origin 永远带），至少一项。
CAIRN_CORS_ORIGINS=http://localhost:5173
# 信任的反向代理跳数。0 只用套接字对端，忽略 X-Forwarded-For。
CAIRN_TRUST_PROXY_HOPS=0
# API 实例登记。未设 CAIRN_API_ID 时派生 hostname:port，页面会标注自动派生。
# CAIRN_API_ID=
# CAIRN_API_HEARTBEAT_MS=5000
# CAIRN_API_LOST_AFTER_SECONDS=45


# ══════════════════════════════════════════════════════════════
# 7. 执行面（Worker 进程专属）
# ══════════════════════════════════════════════════════════════
# ── 7.1 节点身份与任务调度 (Fleet & Lease) ──
# 正式部署每实例必须唯一；同 ID 双开且心跳仍新鲜时启动失败。本地空值回落到 local-worker。
CAIRN_WORKER_ID=
# 单 Worker 允许并发执行的 Run 数量。
# 【注意】：若任务涉及浏览器操作，此并发数受制于 CAIRN_BROWSER_MAX_SESSIONS；建议两者保持匹配以避免无谓排队。
CAIRN_WORKER_CAPACITY=1
# all（默认）装配领取、调度与回收；可写成 executor,scheduler,maintenance 的组合。
# CAIRN_WORKER_ROLES=all
# Worker 内部 HTTP。只允许 loopback；0 仅用于 local 测试且不得同时配广告 URL。
CAIRN_WORKER_INTERNAL_HOST=127.0.0.1
CAIRN_WORKER_INTERNAL_PORT=8091
# 显式广告入口。未设置时库内 internal_base_url 为 null，不从监听地址拼接。
CAIRN_WORKER_ADVERTISE_URL=
# Worker 心跳与 RunLease 续租共用这一个定时器。
CAIRN_WORKER_HEARTBEAT_MS=5000
# 须 ≥ 3 × HEARTBEAT 秒；LOST_AFTER 必须严格大于 TTL。
CAIRN_RUN_LEASE_TTL_SECONDS=30
CAIRN_WORKER_LOST_AFTER_SECONDS=45
# **重要区分**：这是单个 Run 因 Worker 节点意外宕机/失联后的「故障接管恢复次数上限」，
# **绝对不是**业务步骤失败的重试次数（业务步骤失败重试在 Scenario 编排中定义）。
CAIRN_RUN_MAX_RECOVERIES=3
# 周期任务槽位：单飞租约、失败重试、回收排空预算（须小于 reaper 周期）。
# CAIRN_PERIODIC_SLOT_LEASE_TTL_MS=60000
# CAIRN_PERIODIC_SLOT_FAILURE_RETRY_MS=5000
# CAIRN_REAPER_DRAIN_BUDGET_MS=5000
# CAIRN_CREDENTIAL_REMINDER_SCAN_INTERVAL_MS=60000

# ── 7.2 受管浏览器与会话基础设施 (Browser Runtime Infrastructure) ──
# 惰性启动：首个需要会话的 Run 才 launch。非 development 时 PROFILE_DIR 必须是绝对路径。
# 注：会话空闲 TTL、最大寿命、人工认证等待已迁入控制台「治理 → 平台配置」会话组；
# 租约 TTL、心跳与收割节奏仍是基础设施，在此配置。
CAIRN_BROWSER_HEADLESS=true
CAIRN_BROWSER_PROFILE_DIR=.data/browser-profiles
CAIRN_BROWSER_MAX_SESSIONS=2
CAIRN_BROWSER_EXECUTABLE_PATH=
CAIRN_SESSION_LEASE_TTL_SECONDS=30       # 须 ≥ 3 × CAIRN_SESSION_HEARTBEAT_MS/1000
CAIRN_SESSION_HEARTBEAT_MS=5000
CAIRN_SESSION_REAPER_INTERVAL_MS=15000

# ── 7.3 执行面高级运行保护 (Execution Protection) ──
# AI 超时 / 取消后等待底层调用落定的窗口；未落定则强制关闭 Session。
# （其他模型服务地址、模型族、Secret 引用与预算参数一律在控制台「治理 → 平台配置」中维护）
CAIRN_BROWSER_AI_HANG_WAIT_MS=5000

# ══════════════════════════════════════════════════════════════
# 8. 编写与特性闸门 (Authoring & Feature Flags)
# ══════════════════════════════════════════════════════════════
# 示教文件/扩展新录制协议导入总开关。
CAIRN_DEMONSTRATION_ENABLED=true
